# Curator — environment variable template
# Copy to .env and fill in real values before running docker compose up.
# Never commit .env to git.

# PostgreSQL — steward role (used by Postgres container init)
POSTGRES_DB=wcyj
POSTGRES_USER=steward
POSTGRES_PASSWORD=change_me

# PostgreSQL — web_app_user role (used by the app via dbkit/PGPASSWORD)
# Must match the password set in 06_api.sql for the web_app_user role.
WEB_APP_USER_PASSWORD=change_me

# App
APP_PORT=8080
