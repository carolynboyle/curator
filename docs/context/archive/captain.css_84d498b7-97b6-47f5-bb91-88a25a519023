/* =============================================================================
   Captain Workspace — French Blue palette
   #234187 family: authority, command, full access
   ============================================================================= */

:root {
    --crew-primary:   #234187;   /* card, header background */
    --crew-dark:      #1a3066;   /* table headers, hover darken */
    --crew-mid:       #4a6db5;   /* links, active states */
    --crew-light:     #dce6f7;   /* row highlights, tints */
    --crew-tint:      #f0f4fc;   /* alternating rows, subtle bg */
    --crew-text:      #ffffff;   /* text on primary/dark backgrounds */
}

/* -- Card (landing page) --------------------------------------------------- */

.crew-card.captain {
    background-color: var(--crew-primary);
    color: var(--crew-text);
}

.crew-card.captain h2 {
    color: var(--crew-text);
}

.crew-card.captain p {
    color: rgba(255, 255, 255, 0.85);
}

.crew-card.captain:hover {
    background-color: var(--crew-dark);
    border-color: var(--crew-mid);
}

/* -- Crew page header ------------------------------------------------------- */

.crew-section.captain .crew-header {
    background-color: var(--crew-primary);
    color: var(--crew-text);
    padding: 1.25rem 1.5rem;
    border-radius: 8px 8px 0 0;
    margin-bottom: 1.5rem;
}

.crew-section.captain .crew-header h1 {
    color: var(--crew-text);
}

.crew-section.captain .crew-header .btn-back {
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.85rem;
    text-decoration: none;
}

.crew-section.captain .crew-header .btn-back:hover {
    color: var(--crew-text);
}

/* -- Table ------------------------------------------------------------------ */

.crew-section.captain .records-table thead {
    background-color: var(--crew-dark);
    color: var(--crew-text);
}

.crew-section.captain .records-table tbody tr:hover {
    background-color: var(--crew-tint);
}

.crew-section.captain .records-table a {
    color: var(--crew-mid);
}

/* -- Badges ----------------------------------------------------------------- */

.crew-section.captain .badge {
    background-color: var(--crew-light);
    color: var(--crew-dark);
}
